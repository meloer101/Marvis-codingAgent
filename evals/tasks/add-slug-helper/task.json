{
  "id": "add-slug-helper",
  "prompt": "Implement the slugify function in src/slug.js so the whole test suite passes (run it with `npm test`). Do not change the tests.",
  "model": "deepseek/deepseek-v4-flash",
  "mode": "acceptEdits",
  "tags": [
    "feature"
  ],
  "runs": 3,
  "allow": [
    "Bash(npm:*)",
    "Bash(node:*)"
  ],
  "graders": [
    {
      "name": "tests-untouched"
    },
    {
      "name": "diff-size",
      "maxChangedLines": 20,
      "maxNewFiles": 0
    },
    {
      "name": "scratch-sprawl",
      "allow": []
    },
    {
      "name": "first-touch",
      "deliverable": [
        "src/slug.js"
      ]
    }
  ]
}
