{
  "id": "fix-null-deref",
  "prompt": "The test suite (run it with `npm test`) is failing. Find the bug in src/config.js and fix it so every test passes. Do not change any file under test/.",
  "model": "deepseek/deepseek-flash",
  "mode": "acceptEdits",
  "tags": [
    "bug-fix"
  ],
  "runs": 3,
  "allow": [
    "Bash(npm:*)",
    "Bash(node:*)"
  ],
  "graders": [
    {
      "name": "tests-untouched"
    },
    {
      "name": "diff-size",
      "maxChangedLines": 15,
      "maxNewFiles": 0
    },
    {
      "name": "scratch-sprawl",
      "allow": []
    },
    {
      "name": "first-touch",
      "deliverable": [
        "src/config.js"
      ]
    }
  ]
}
